APP_NAME="Prodi Teknologi Informasi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Konfigurasi database MySQL/XAMPP.
# Buat database kosong lewat phpMyAdmin, lalu isi DB_DATABASE di bawah.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prodi_ti
DB_USERNAME=root
DB_PASSWORD=

# Akun Staff Prodi pertama yang dibuat oleh StaffProdiSeeder.
STAFF_NAMA="Sylvi, A.Md"
STAFF_EMAIL=staff@politala.ac.id
STAFF_NIP=198001012005011001
STAFF_PASSWORD=password123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# LOGIN DENGAN GOOGLE (revisi 26-09-2026) — Laravel Socialite
# Isi dari Google Cloud Console > APIs & Services > Credentials (OAuth client "Web application").
# Authorized redirect URI: http://localhost:8000/auth/google/callback (sesuaikan APP_URL)
# Kosongkan GOOGLE_REDIRECT_URI untuk memakai {APP_URL}/auth/google/callback.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Domain email yang diizinkan (dicocokkan persis; akun tetap harus terdaftar di database)
DOMAIN_EMAIL_MAHASISWA=mhs.politala.ac.id
DOMAIN_EMAIL_STAFF=politala.ac.id

# ---------------------------------------------------------------------------
# EMAIL PENGUMUMAN via GMAIL (revisi 26-09-2026)
# Selama MAIL_MAILER=log, email hanya ditulis ke storage/logs/laravel.log.
# Untuk mengirim sungguhan lewat Gmail, ubah blok MAIL_* di atas menjadi:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=akun.prodi@gmail.com
#   MAIL_PASSWORD=<App Password 16 digit dari akun Google>
#   MAIL_FROM_ADDRESS=akun.prodi@gmail.com
#   MAIL_FROM_NAME="Prodi Teknologi Informasi"
# ---------------------------------------------------------------------------
